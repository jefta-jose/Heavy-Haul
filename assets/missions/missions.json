    "sprint": { "weight": 2, "titles": ["Sprint", "Leg race", "Quick leg", "Dash"], "minPerKm": [2.4, 3.8] },
    "cameras": { "weight": 2, "titles": ["Speed trap", "Flash the cameras", "Radar run", "Lead foot"], "kmh": [40, 80], "step": 5, "ofTopSpeed": 0.82 },
    "crusher": { "weight": 2, "titles": ["Crusher", "Demolition", "Rock breaker", "Clear the way"], "count": [20, 70], "step": 5 },
    "bogs": { "weight": 2, "titles": ["Bog master", "Mud runner", "Swamp crossing", "Bog hopper"], "min": 3 },
    "clean": { "weight": 2, "titles": ["Clean run", "Handle with care", "Fragile cargo", "Gentle hands"], "maxDamage": [8, 35] }
